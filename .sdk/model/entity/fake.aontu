# Entity: fake

main: kit: entity: fake: {

  alias: field: {}

  fields: {
    exists: {
      h: "Exists"
      n: "exists"
      r: true
      sh: "Always false."
      t: "`$BOOLEAN`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "A made-up village name that is nowhere in the register."
      t: "`$STRING`"
    }
    permalink: {
      h: "Permalink"
      n: "permalink"
      r: true
      sh: "Link that reproduces this name."
      t: "`$STRING`"
    }
    seed: {
      h: "Seed"
      n: "seed"
      r: true
      sh: "The seed; the same seed always gives the same name."
      t: "`$STRING`"
    }
    sign: {
      h: "Sign"
      n: "sign"
      r: true
      sh: "Link to its entry sign (SVG image)."
      t: "`$STRING`"
    }
  }

  name: "fake"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /sate/fake"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "mamaliga"
                k: "query"
                n: "seed"
                or: "seed"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/sate/fake"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "sate"
            }
            {
              lit: "fake"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
